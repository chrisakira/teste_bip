{
  "info": {
    "name": "BIP App Backend",
    "_postman_id": "bip-app-collection",
    "description": "Collection for BIP App backend endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "List Beneficios",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/beneficios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api","v1","beneficios"
          ]
        }
      }
    },
    {
      "name": "Get Beneficio by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/beneficios/:id",
          "host": ["{{baseUrl}}"],
          "path": ["api","v1","beneficios",":id"]
        }
      }
    },
    {
      "name": "Create Beneficio",
      "request": {
        "method": "POST",
        "header": [
          {"key":"Content-Type","value":"application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Novo\",\n  \"descricao\": \"Teste\",\n  \"valor\": 300.00\n}"
        },
        "url": {"raw":"{{baseUrl}}/api/v1/beneficios","host":["{{baseUrl}}"],"path":["api","v1","beneficios"]}
      }
    },
    {
      "name": "Update Beneficio",
      "request": {
        "method": "PUT",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "body": {"mode":"raw","raw":"{\n  \"id\":1,\n  \"nome\":\"Atualizado\",\n  \"descricao\":\"Alterado\",\n  \"valor\":350.00\n}"},
        "url": {"raw":"{{baseUrl}}/api/v1/beneficios/:id","host":["{{baseUrl}}"],"path":["api","v1","beneficios",":id"]}
      }
    },
    {
      "name": "Delete Beneficio",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {"raw":"{{baseUrl}}/api/v1/beneficios/:id","host":["{{baseUrl}}"],"path":["api","v1","beneficios",":id"]}
      }
    },
    {
      "name": "Transferir",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "body": {"mode":"raw","raw":"{\n  \"origemId\": 1,\n  \"destinoId\": 2,\n  \"valor\": 100.00\n}"},
        "url": {"raw":"{{baseUrl}}/api/v1/beneficios/transferir","host":["{{baseUrl}}"],"path":["api","v1","beneficios","transferir"]}
      }
    }
  ]
}
